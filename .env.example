# PostgreSQL connection strings for Prisma 7 (Supabase)
# Pooled transaction connection (port 6543) for app runtime
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
# Direct / session connection (port 5432) for Prisma migrations & db push
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# Better Auth
BETTER_AUTH_SECRET="replace-with-a-secure-32-char-secret"
BETTER_AUTH_URL="http://localhost:3000"

# Initial Admin Seed (local/one-time seed only — never hardcode in git)
SEED_ADMIN_NAME="Admin Tech Bro"
SEED_ADMIN_EMAIL="admin@techbro.dev"
SEED_ADMIN_PASSWORD="replace-with-a-strong-password"
